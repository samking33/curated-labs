# Hostinger's Node app publish step only ships the Root Directory's own
# contents (backend/ or frontend/) into the deployed version folder - it
# does NOT carry along the workspace's shared node_modules/.pnpm store
# that pnpm's default symlinked layout depends on. Every dependency
# resolved as a symlink into that store (e.g. reflect-metadata) becomes a
# dangling link on the deployed server -> MODULE_NOT_FOUND crash-loop at
# startup, confirmed live via SSH (stderr.log).
#
# node-linker=hoisted makes node_modules a real, flat, self-contained copy
# (npm/yarn-classic style, no symlinks to an external store) - safe to ship
# as just the one directory regardless of what a deploy platform does or
# doesn't carry along beside it.
node-linker=hoisted
