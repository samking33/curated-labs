# Duplicated from the repo root .npmrc: Hostinger's checkout for this app
# (Root Directory: frontend) only ships frontend/'s own files, not the repo
# root - confirmed live via SSH for the sibling backend app (hbuilds/last-source
# only contained that directory's own contents, no root .npmrc). See the
# root .npmrc for the full explanation of why node-linker=hoisted is required.
node-linker=hoisted
