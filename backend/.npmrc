# Duplicated from the repo root .npmrc: Hostinger's checkout for this app
# (Root Directory: backend) only ships backend/'s own files, not the repo
# root - confirmed live via SSH (hbuilds/last-source only contained this
# directory's contents, no root .npmrc). See the root .npmrc for the full
# explanation of why node-linker=hoisted is required.
node-linker=hoisted
