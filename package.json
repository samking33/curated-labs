{
  "name": "curated-labs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "nim:inspect": "node --env-file=.env --experimental-strip-types scripts/nim/inspect-models.ts",
    "nim:smoke": "node --env-file=.env --experimental-strip-types scripts/nim/smoke-test-models.ts"
  }
}
