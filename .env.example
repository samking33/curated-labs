NODE_ENV=development

DATABASE_URL=postgresql://app:app@localhost:5432/curated_labs
# Only needed against a pooled DATABASE_URL (e.g. PgBouncer/Neon `-pooler` host) —
# `prisma migrate` takes an advisory lock a pooled connection can't hold. Falls
# back to DATABASE_URL when unset, so a plain local Postgres needs no second variable.
DIRECT_URL=postgresql://app:app@localhost:5432/curated_labs

WEB_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

SESSION_SECRET=replace-with-strong-secret

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified working on 2026-08-03 — see docs/ai-rules.md. Leave blank to use defaults.
NVIDIA_NIM_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_MODEL_JSON=openai/gpt-oss-20b
NVIDIA_NIM_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_NIM_MODEL_EMBEDDING=nvidia/nv-embedqa-e5-v5
AI_MODEL_AUTO_SELECT=true
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=25000
AI_RETRY_COUNT=1
# Ceiling for a whole coaching task across all retries and fallback models.
AI_TASK_BUDGET_MS=45000

# Custom Playground scenario generation is a slower, heavier call than
# coaching (benchmarked ~85s, ~6-7k output tokens on nemotron-3-super-120b-a12b)
# so it gets its own budget/token ceilings instead of AI_TASK_BUDGET_MS/AI_MAX_OUTPUT_TOKENS.
PLAYGROUND_GEN_MAX_OUTPUT_TOKENS=12000
PLAYGROUND_GEN_BUDGET_MS=150000
# Per-attempt timeout for generation calls — without this override the
# generic AI_TIMEOUT_MS (25s) caps every attempt, so the benchmarked ~85s
# generator model always timed out and every job silently fell back to a
# weaker model.
PLAYGROUND_GEN_ATTEMPT_TIMEOUT_MS=140000

# Playground scenario generation only — NIM's fallback chain for this task
# was unreliable. Everything else (coaching feedback) still runs on NIM above.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Rolling-window generation quotas.
PLAYGROUND_GEN_PER_USER=10
PLAYGROUND_GEN_PER_ORG=50
PLAYGROUND_QUOTA_WINDOW_HOURS=24
# A job stuck "running" past this long is reaped back to "failed".
PLAYGROUND_STALE_JOB_MS=300000

# Development only. The API refuses to boot with this enabled in production.
ALLOW_DEV_LOGIN=false
# Client-side switch for the DevLogin button on /login, independent of the
# backend flag above. Both must be on.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false

# Required whenever ALLOW_DEV_LOGIN is on and the deployment is reachable over
# the internet, where dev login is otherwise a complete authentication bypass:
# it takes an email address and asks for nothing else. Minimum 12 characters,
# and the API refuses to start without it in that case.
DEV_LOGIN_PASSCODE=

# Which peer may set X-Forwarded-For. Defaults to loopback, the frontend's
# rewrite proxy on the same host. Naming it matters: trusting any caller's
# header lets one present a new address per request and evade rate limiting.
# Accepts an address, a CIDR, or the names "loopback"/"linklocal"/"uniquelocal".
TRUSTED_PROXY=loopback

# Interface the API binds to. Leave unset for container platforms that route
# to 0.0.0.0; set to 127.0.0.1 where only a local reverse proxy should reach it.
BIND_HOST=
